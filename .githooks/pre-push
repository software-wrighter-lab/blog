#!/usr/bin/env bash
# Refuse to push any commit tree that contains merge-conflict markers.
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
top=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
revs=()
while read -r _lref lsha _rref _rsha; do
  [[ "$lsha" == "$zero" ]] && continue
  revs+=("$lsha")
done
[[ ${#revs[@]} -eq 0 ]] && exit 0
exec "$top/scripts/check-conflict-markers" "${revs[@]}"
