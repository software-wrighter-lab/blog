#!/usr/bin/env bash
# Promote a draft from the `drafts` branch to _posts/ on `main`, dating it.
#
#   scripts/publish usb-uart-comparison               # publish today
#   scripts/publish usb-uart-comparison 2026-08-10    # schedule for a future date
#   scripts/publish --list
#
# Drafts live on the `drafts` branch so that `main` --- the branch anyone
# browsing this repo sees first --- contains only published content. Publishing
# therefore moves a file between branches rather than between directories.
#
# main is manipulated through a temporary git worktree, so your working copy
# stays on `drafts` and a running `scripts/preview` is never disturbed.
#
# A future-dated post sits in _posts/ on main and is invisible to every build
# until its date arrives; the daily GitHub Actions cron then publishes it. All
# indexes --- archive, tags, categories, hardware, search.json, feed, sitemap ---
# are regenerated by Jekyll at build time. Nothing is updated by hand.
set -euo pipefail

cd "$(dirname "$0")/.."

POST_TIME="00:15:00"   # just before the 00:20 publish cron; see docs/workflow.md
DRAFT_BRANCH="drafts"
LIVE_BRANCH="main"

if [[ $# -lt 1 ]]; then
  echo "usage: scripts/publish <draft-slug> [YYYY-MM-DD]" >&2
  echo "       scripts/publish --list" >&2
  exit 1
fi

if [[ "$1" == "--list" ]]; then
  echo "drafts on $DRAFT_BRANCH:"
  git ls-tree --name-only "$DRAFT_BRANCH" _drafts/ 2>/dev/null \
    | grep -v 'README.md$' \
    | sed 's|_drafts/||; s|\.md$||; s|^|  |' || echo "  (none)"
  exit 0
fi

slug="${1%.md}"; slug="${slug#_drafts/}"
date_arg="${2:-$(date +%Y-%m-%d)}"

if ! [[ "$date_arg" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "error: date must be YYYY-MM-DD, got '$date_arg'" >&2; exit 1
fi
if [[ "$date_arg" < "$(date +%Y-%m-%d)" ]]; then
  echo "error: $date_arg is in the past; a back-dated post buries itself" >&2; exit 1
fi

src="_drafts/${slug}.md"
if ! git cat-file -e "${DRAFT_BRANCH}:${src}" 2>/dev/null; then
  echo "error: $src not found on branch $DRAFT_BRANCH (try scripts/publish --list)" >&2
  exit 1
fi

# Refuse to run with uncommitted draft edits --- otherwise you publish the
# committed version and silently leave newer text behind.
if ! git diff --quiet -- _drafts || ! git diff --cached --quiet -- _drafts; then
  echo "error: uncommitted changes under _drafts/. Commit them first, or the" >&2
  echo "       published post will not match what you have been editing." >&2
  exit 1
fi

dest="_posts/${date_arg}-${slug}.md"
tz_offset=$(date +%z)
work=$(mktemp -d)
cleanup() { git worktree remove --force "$work" 2>/dev/null || true; rm -rf "$work"; }
trap cleanup EXIT

echo "preparing $LIVE_BRANCH in a temporary worktree..."
git fetch -q origin "$LIVE_BRANCH" 2>/dev/null || true
git worktree add -q "$work" "$LIVE_BRANCH"
git -C "$work" pull -q --ff-only origin "$LIVE_BRANCH" 2>/dev/null || true

if [[ -e "$work/$dest" ]]; then
  echo "error: $dest already exists on $LIVE_BRANCH" >&2; exit 1
fi

mkdir -p "$work/_posts"
# Set or insert the date inside the front matter block.
git show "${DRAFT_BRANCH}:${src}" | awk -v newdate="date: ${date_arg} ${POST_TIME} ${tz_offset}" '
  BEGIN { fm = 0; seen_date = 0 }
  NR == 1 && $0 == "---" { fm = 1; print; next }
  fm == 1 && /^---[[:space:]]*$/ { if (!seen_date) print newdate; fm = 2; print; next }
  fm == 1 && /^date:/ { print newdate; seen_date = 1; next }
  { print }
' > "$work/$dest"

if [[ -x "$work/scripts/validate" ]]; then
  ( cd "$work" && git add "$dest" && scripts/validate ) || {
    echo "error: validation failed; nothing was pushed" >&2; exit 1; }
else
  git -C "$work" add "$dest"
fi

if [[ "$date_arg" == "$(date +%Y-%m-%d)" ]]; then
  msg="Publish: ${slug}"
else
  msg="Schedule: ${slug} (publish ${date_arg})"
fi

git -C "$work" commit -q -m "$msg"
git -C "$work" push -q origin "$LIVE_BRANCH"
echo "$msg"

# Retire the draft, then bring main's history back into drafts so the branch
# keeps tracking the live theme and scripts.
git rm -q "$src"
git commit -q -m "Published: ${slug}"
git fetch -q origin "$LIVE_BRANCH"
git merge -q --no-edit "origin/${LIVE_BRANCH}" || {
  echo "note: merge from $LIVE_BRANCH needs attention; resolve and commit" >&2; }
git push -q origin "$DRAFT_BRANCH" 2>/dev/null || \
  git push -q --set-upstream origin "$DRAFT_BRANCH"

if [[ "$date_arg" == "$(date +%Y-%m-%d)" ]]; then
  echo "deploying now -- watch: gh run watch"
else
  echo "will go live on ${date_arg} via the daily publish cron"
fi
